# Supabase Postgres — pooled connection (port 6543), used at runtime
DATABASE_URL=

# Supabase Postgres — direct connection (port 5432), used for migrations only
DIRECT_URL=

# Supabase project URL
SUPABASE_URL=

# Supabase anon/publishable key (safe for client use, but read here for the backend's own client)
SUPABASE_PUBLISHABLE_KEY=

# Supabase service_role key — server-only, NEVER expose to the frontend or commit this
SUPABASE_SECRET_KEY=

# Port the Express server listens on. Render sets this automatically in production —
# only needed for local dev.
PORT=5000

# Comma-separated list of allowed frontend origins for CORS, e.g.:
# https://your-app.vercel.app,https://your-custom-domain.com
# Defaults to http://localhost:5173 if unset (local dev only — set this in production).
CORS_ORIGIN=http://localhost:5173
